# --- Local login (day-to-day) ---
AS_BASE_URL=https://agentswitch.theschoolofai.in
AS_EMAIL=team13@theschoolofai.in
AS_PASSWORD=

# Optional: Keystone
# AS_BASE_URL=https://class.agentswitch.theschoolofai.in

# --- Official harness (set by AgentSwitch server; also usable locally) ---
# AGENTSWITCH_BASE_URL=https://agentswitch.theschoolofai.in
# AGENTSWITCH_TOKEN=
# AGENTSWITCH_INSTANCE=suryodaya
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=

# --- Local model (Gemini via OpenAI-compatible endpoint) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Comma-separated fallbacks on 429/503 (same API key / endpoint)
GEMINI_MODEL_FALLBACKS=gemini-flash-lite-latest,gemini-3.1-flash-lite-preview,gemini-2.5-flash
# Optional override; default is Gemini's OpenAI-compat URL
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Agent defaults
AGENT_MAX_STEPS=24
AGENT_ALLOW_WRITES=false

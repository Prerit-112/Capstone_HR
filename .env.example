# --- Local login (day-to-day) ---
AS_BASE_URL=https://agentswitch.theschoolofai.in
AS_EMAIL=team13@theschoolofai.in
AS_PASSWORD=

# Optional: Keystone
# AS_BASE_URL=https://class.agentswitch.theschoolofai.in

# --- Official harness (injected by AgentSwitch; no .env on the server) ---
# AGENTSWITCH_BASE_URL must be the sandbox URL from the harness — never hard-code it.
# AGENTSWITCH_BASE_URL=
# AGENTSWITCH_TOKEN=
# AGENTSWITCH_INSTANCE=suryodaya
# OPENAI_BASE_URL=
# OPENAI_API_KEY=
# OPENAI_MODEL=

# --- Local model (Gemini via OpenAI-compatible endpoint) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Comma-separated fallbacks on 429/503 (same API key / endpoint)
GEMINI_MODEL_FALLBACKS=gemini-flash-lite-latest,gemini-3.1-flash-lite-preview,gemini-2.5-flash
# Optional override; default is Gemini's OpenAI-compat URL
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Agent defaults
AGENT_MAX_STEPS=10
AGENT_ALLOW_WRITES=false
# Transient LLM retries (platform defaults higher when OPENAI_BASE_URL+KEY set)
# LLM_RETRIES_PER_MODEL=5
# LLM_BACKOFF_SECONDS=3
# Pause between harness tasks to reduce late-suite rate limits (seconds)
# LLM_INTER_TASK_SLEEP=2
# Cumulative billed tokens per task (~40k × 11 keeps a suite under a 500k run)
# LLM_TASK_TOKEN_LIMIT=40000
# Cap each tool result in the chat transcript (write tasks default tighter)
# LLM_TOOL_CONTENT_LIMIT=
